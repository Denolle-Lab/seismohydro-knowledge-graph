# Copy to .env, or export in your shell. Never commit the real file.
# Free key from https://openalex.org/settings/api. Raises the budget from $0.10 to $1 per day
# and is required to follow cursors past the first page.
OPENALEX_API_KEY=

# For LLM extraction with --provider claude only.
ANTHROPIC_API_KEY=

# For --provider olmo or another local model: where your server listens, and its key if it has one.
# Whatever listens on this address receives abstract text. On a shared machine, require a key.
SHKG_LOCAL_BASE_URL=
SHKG_LOCAL_API_KEY=
